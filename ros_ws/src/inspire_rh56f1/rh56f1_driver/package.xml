<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rh56f1_driver</name>
  <version>0.1.0</version>
  <description>Per-hand launch for the Inspire RH56F1 vendor driver (inspire_control_ros2): one process per hand on its own RS485 or CANFD port.</description>
  <maintainer email="ukwh5681@gmail.com">divingyoon</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>inspire_control_ros2</exec_depend>
  <exec_depend>rh56f1_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
